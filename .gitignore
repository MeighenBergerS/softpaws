# Python
__pycache__/
*.py[cod]
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/

# Distribution / packaging
MANIFEST
pip-wheel-metadata/

# Testing
.pytest_cache/
.coverage
htmlcov/

# Ruff
.ruff_cache/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Data files — never commit raw or processed data
*.pdf
dataverse_files/
*.fits
*.fits.gz
*.fz
*.h5
*.hdf5
*.hdf
*.npy
*.npz
*.csv
*.parquet
# Ignore a top-level data directory only, so the src/softpaws/data source
# package stays versioned (raw data is caught by the extension rules above).
/data/

# Tabulated cross sections and transport coefficients are small, versioned
# inputs, not bulk release data.
!src/softpaws/data/xsec/**/*.csv
!src/softpaws/data/coefficients/*.csv
# Published KM3NeT/ARCA effective areas: a 60-row table, same category.
!src/softpaws/data/km3net/*.csv
# Digitized P-ONE (ICRC2023) and TRIDENT (Nature Astron. 2023) effective areas.
!src/softpaws/data/pone/*.csv
!src/softpaws/data/trident/*.csv

# IceCube HESE 7.5-year release: ~90 MB of Monte Carlo json, bulk release data.
src/softpaws/data/hese/*.json

# Generated output from examples (keep the directory via .gitkeep)
examples/output/*
!examples/output/.gitkeep

# Paper: the manuscript and everything around it (figures, run logs, plans,
# referee reports, style tooling) lives in /paper and is never synced. The
# derivation notes in docs/ stay versioned and feed the docs site.
/paper/

# LaTeX build products
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.lof
*.lot
*.out
*.synctex.gz
*.toc
texput.log

# Scratch results written by examples at the repository root
/results.json

# IDE / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Pre-commit
.pre-commit-config.yaml

# MkDocs
site/

# Paper-reproduction caches (chains, tables) are rebuilt by the scripts.
scripts/*/cache/
